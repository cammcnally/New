# Python
__pycache__/
*.py[cod]
*.so
.Python
.mypy_cache/
.venv/
venv/
env/
.local/
.env/
node_modules/

# IDE / editor
# `.cursor/` is intentionally tracked so generated projection files and cloud-agent
# environment helpers are available to local and cloud agents.
!.cursor/
!.cursor/**
.idea/
*.swp
*.swo

# Overnight agent attempt payloads (local only)
ops/overnight/out/

# Pipeline run outputs (regenerable)
pipeline_outputs/
pipeline_outputs_*/

# Local relocated Python package bundle
python312_user_relocated/

# Ad-hoc / backup virtualenvs (canonical is .venv/)
.venv311/
.venv-py312-backup/

# Drive sync / temp upload debris
.tmp.driveupload/

# Local bundle notes (not repo documentation)
BUNDLE_README.md
BUNDLE_README.txt

# DVC
*.dvc
.dvc/config.local
.dvc/tmp
.dvc/cache

# MLflow
mlruns/

# Lineage events
lineage_events/

# Market data ingestion
data_lake/
*.duckdb
*.duckdb.wal
.env

# Cleanup audit outputs
outputs/
!outputs/.gitkeep

# Repo runtime: mirror backups and local-only debris (never stage)
.repo_runtime/

# Repo inventory: keep latest snapshot only in VCS (timestamped runs are local)
artifacts/repo_inventory/inventory_*.json
!artifacts/repo_inventory/inventory_latest.json

