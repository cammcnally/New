{
  "expectation_suite_name": "raw_panel_ingest",
  "meta": {
    "description": "OHLCV panel at ingest: required columns must be present, prices and volume non-negative, no duplicate (ticker, timestamp) pairs. Extra columns are permitted."
  },
  "expectations": [
    {
      "expectation_type": "expect_table_columns_to_match_set",
      "kwargs": {
        "column_set": [
          "ticker",
          "timestamp_utc",
          "open",
          "high",
          "low",
          "close",
          "volume",
          "is_incomplete_session"
        ],
        "exact_match": false
      },
      "meta": {}
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": { "column": "ticker" },
      "meta": {}
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": { "column": "timestamp_utc" },
      "meta": {}
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": { "column": "open" },
      "meta": {}
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": { "column": "high" },
      "meta": {}
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": { "column": "low" },
      "meta": {}
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": { "column": "close" },
      "meta": {}
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": { "column": "volume" },
      "meta": {}
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": { "column": "open", "min_value": 0, "strict_min": false },
      "meta": {}
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": { "column": "high", "min_value": 0, "strict_min": false },
      "meta": {}
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": { "column": "low", "min_value": 0, "strict_min": false },
      "meta": {}
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": { "column": "close", "min_value": 0, "strict_min": false },
      "meta": {}
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": { "column": "volume", "min_value": 0, "strict_min": false },
      "meta": {}
    },
    {
      "expectation_type": "expect_compound_columns_to_be_unique",
      "kwargs": { "column_list": ["ticker", "timestamp_utc"] },
      "meta": {}
    }
  ]
}
